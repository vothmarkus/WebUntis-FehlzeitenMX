<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WebUntis-FehlzeitenMX.Android</AssemblyName>
    <RootNamespace>WebUntisAuswertung.Mobile</RootNamespace>
    <ApplicationTitle>WebUntis-FehlzeitenMX</ApplicationTitle>
    <ApplicationId>de.markusvoth.webuntisfehlzeitenmx</ApplicationId>
    <ApplicationDisplayVersion>0.4.0</ApplicationDisplayVersion>
    <ApplicationVersion>5</ApplicationVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidAbi Condition="'$(AndroidAbi)' == ''">android-arm64</AndroidAbi>
    <RuntimeIdentifier>$(AndroidAbi)</RuntimeIdentifier>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../Core/WebUntisAuswertung.Core.csproj" />
    <MauiIcon Include="Resources/AppIcon/bkt.png" Color="#FFFFFF" />
    <MauiImage Include="Resources/Images/bkt_logo.png" BaseSize="40,40" Resize="true" />
  </ItemGroup>
</Project>
